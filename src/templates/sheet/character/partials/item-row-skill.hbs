<li class="item item--skill collapsed" data-item-id="{{item._id}}">
  <div class="item-title-row">
    <div class="item-title-row__lead">
      {{> "systems/projectmoonttrpg/templates/sheet/character/partials/item-thumb.hbs" img=item.img name=item.name}}
      <strong class="item-name">{{item.name}}</strong>
      <img class="icon-lightcost" src="systems/projectmoonttrpg/assets/icons/sheet/00_light.webp" alt="">
      <strong class="item-lightcost">{{item.system.lightCost}}</strong>
    </div>
    <div class="item-controls">
      {{> "systems/projectmoonttrpg/templates/sheet/character/partials/item-controls-skill.hbs" itemId=item._id}}
    </div>
  </div>
  <div class="item-details">
    <div class="item-tags">
      {{#if (lookup selects.skillTypes item.system.skillType)}}
        <span class="tag">{{localize (lookup selects.skillTypes item.system.skillType)}}</span>
      {{/if}}
      <span class="tag">{{localize "PMTTRPG.SkillLightCost"}}: {{item.system.lightCost}}</span>
      {{#if item.system.rank}}
        <span class="tag tag--rank">{{localize "PMTTRPG.SkillRank"}}: {{item.system.rank}}</span>
      {{/if}}
    </div>
    {{#if item.system.descriptionEnriched}}
    <div class="item-flavor description">{{{item.system.descriptionEnriched}}}</div>
    {{/if}}
    {{#if item.system.effectSummaryText}}
      {{{item.system.effectSummaryText}}}
    {{/if}}
  </div>
</li>
