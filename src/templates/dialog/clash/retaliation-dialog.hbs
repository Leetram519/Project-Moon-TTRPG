<form class="clash-retaliation-form">

  {{!-- Context header: who is attacking you --}}
  <div class="clash-retaliation-form__context">
    <img class="clash-card__avatar" src="{{state.attackerImg}}" alt="{{state.attackerName}}">
    <div class="clash-retaliation-form__context-text">
      <span class="clash-retaliation-form__attacked-by">{{i18n.attackedBy}}</span>
      <span class="clash-retaliation-form__weapon">{{state.attackerName}} using {{state.attackerItemName}}</span>
    </div>
  </div>

  <hr class="clash-retaliation-form__divider">

  {{!-- Option list --}}
  <div class="clash-retaliation-form__options">
    {{#each options}}
      <label class="clash-option
        {{#if requiresItem}}clash-option--has-items{{/if}}
        {{#if unavailable}}clash-option--unavailable{{/if}}"
        data-type="{{type}}">

        <input
          type="radio"
          name="retaliationType"
          value="{{type}}"
          {{#if checked}}checked{{/if}}
          {{#if unavailable}}disabled{{/if}}
        >

        <span class="clash-option__icon">
          <img
            class=""
            src="{{icon}}.webp"
          >
        </span>

        <span class="clash-option__label">
          {{#if labelText}}
            {{labelText}}
          {{else}}
            {{localize label}}
          {{/if}}
        </span>
        {{#if unavailable}}
          <span class="clash-option__unavailable-tag">{{localize "PMTTRPG.Clash.NoReaction"}}</span>
        {{/if}}
        {{#if (eq type "counter")}}
          <span class="clash-option__range-tag" hidden>{{localize "PMTTRPG.Dialog.outOfRange"}}</span>
        {{/if}}

        {{!-- Inline item data for JS to read --}}
        {{#if requiresItem}}
          {{#each items}}
            <span
              class="clash-item-option"
              data-type="{{../type}}"
              data-item-id="{{id}}"
              data-item-name="{{name}}"
              data-affordable="{{#if (eq affordable false)}}0{{else}}1{{/if}}"
              {{#if (eq ../type "counter")}}
              data-in-range="{{#if inRange}}1{{else}}0{{/if}}"
              data-range="{{range}}"
              data-distance="{{distance}}"
              {{/if}}
              hidden
            ></span>
          {{/each}}
        {{/if}}

      </label>
    {{/each}}
  </div>

  <label class="consume-toggle clash-consume-reaction">
    <input type="checkbox" name="consumeReaction" checked />
    <span>{{i18n.consumeReaction}}</span>
  </label>

  {{#if breakFree}}
  <label class="consume-toggle clash-break-free" style="display: none;">
    <input type="checkbox" name="breakFreeAfterHit" />
    <span>{{breakFree.label}}</span>
  </label>
  {{/if}}

  {{!-- Item picker — shown only when counter/evade/block/recycled is selected --}}
  <div class="clash-item-picker" style="display: none;">
    <label class="clash-item-picker__label">
      <i class="fa-solid fa-list"></i>
      <span
        class="clash-item-picker__kind"
        data-weapon="{{i18n.weapon}}"
        data-outfit="{{i18n.outfit}}"
      >{{i18n.weapon}}</span>
    </label>
    <select name="retaliationItemId" class="clash-item-picker__select">
    </select>
  </div>

  <div class="clash-range-notice" hidden>
    <i class="fa-solid fa-ruler-combined" aria-hidden="true"></i>
    <p class="clash-range-notice__text"></p>
  </div>

  {{!-- Optional Skill matching the chosen Reaction --}}
  <div class="clash-skill-picker" data-none-label="{{i18n.skillNone}}" style="display: none;">
    <label class="clash-item-picker__label">
      <i class="fa-solid fa-bolt"></i>
      {{i18n.skillOptional}}
    </label>
    <select name="declaredSkillId" class="clash-item-picker__select">
      <option value="">{{i18n.skillNone}}</option>
    </select>
    {{#each skills}}
      <span
        class="clash-skill-option"
        data-skill-type="{{skillType}}"
        data-item-id="{{id}}"
        data-item-name="{{name}}"
        hidden
      ></span>
    {{/each}}
    <label class="consume-toggle clash-skill-consume" style="display: none;">
      <input type="checkbox" name="consumeSkillLight" checked />
      <span>{{i18n.consumeLight}}</span>
    </label>
  </div>

  {{!-- Applied Tool hidden while a Skill is selected --}}
  <div class="clash-tool-picker" data-none-label="{{i18n.toolNone}}" style="display: none;">
    <label class="clash-item-picker__label">
      <i class="fa-solid fa-wrench"></i>
      {{i18n.toolOptional}}
    </label>
    <select name="appliedToolId" class="clash-item-picker__select">
      <option value="">{{i18n.toolNone}}</option>
    </select>
    {{#each appliedTools}}
      <span
        class="clash-tool-option"
        data-apply-to="{{applyTo}}"
        data-item-id="{{id}}"
        data-item-name="{{name}}"
        data-remaining="{{remaining}}"
        data-consumes="{{#if consumes}}1{{else}}0{{/if}}"
        hidden
      ></span>
    {{/each}}
    <label class="consume-toggle clash-tool-consume" style="display: none;">
      <input type="checkbox" name="consumeAppliedTool" checked />
      <span>{{i18n.consumeTool}}</span>
    </label>
  </div>

  {{!-- Assist picker for the retaliator (hidden for One-Sided) --}}
  {{#if assistOptions}}
  <div class="clash-assist-picker">
    <label class="clash-item-picker__label">
      <i class="fa-solid fa-handshake-angle"></i>
      {{i18n.assist}}
    </label>
    <select name="assistEntryId" class="clash-item-picker__select">
      {{#each assistOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

</form>
