<div 
    class="character {{#if isExpanded}}is-expanded{{/if}} {{#if isCurrentTurn}}current-turn{{/if}} {{#if canDrag}}character--draggable{{/if}}" 
    {{#if actorData.system.details.color}}style="background: color-mix(var(--ct-bg), {{actorData.system.details.color}} 30%)"{{/if}}
    data-combatant-id="{{combatantData._id}}"
    {{#if rolled}}data-rolled="true"{{/if}}
>
    <div class="main-part">
        <div class="avatar-side">
            <div class="avatar" data-action="openSheet" data-tracker-context data-reveal-key="all" title="{{actorData.name}}">
                <img src="{{actorData.img}}" alt="{{actorData.name}}">
            </div>

            {{#if showDetails}}
            <button
                type="button"
                class="char-toggle-details"
                data-action="toggleDetails"
                aria-expanded="{{isExpanded}}"
                title="{{localize "PMTTRPG.Common.Details"}}"
                aria-label="{{localize "PMTTRPG.Common.Details"}}"
            >
                <i class="fas {{#if isExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>
            {{/if}}
        </div>

        <div class="right-side">
            <div
                class="name-container{{#if canDrag}} char-drag-handle{{/if}}"
                data-tracker-context
                data-reveal-key="all"
                {{#if canDrag}}
                    draggable="true"
                    title="{{localize "PMTTRPG.Combat.ReorderHint"}}"
                {{/if}}
            >
                {{#if actorData.system.details.badge}}
                    <img class="faction-badge" src="{{actorData.system.details.badge}}" draggable="false" alt="">
                {{/if}}
                <span class="char-name">{{actorData.name}}</span>
                {{#if returnsNextRound}}
                    {{#unless delayControl}}
                        <span class="delay-return" data-tooltip="{{localize "PMTTRPG.Delay.ReturnsNextRound"}}">{{localize "PMTTRPG.Delay.ReturnsNextRound"}}</span>
                    {{/unless}}
                {{/if}}
                {{#*inline "actionStateBadgeBody"}}{{#if iconImg}}<img src="{{iconImg}}" alt="" draggable="false">{{else if iconFa}}<i class="fa-solid {{iconFa}}" aria-hidden="true"></i>{{else}}<span class="action-state-badge__text">{{label}}</span>{{/if}}{{/inline}}
                {{#if actionStates.length}}
                    <span class="action-state-strip" role="list" aria-label="{{localize "PMTTRPG.ActionState.StripLabel"}}">
                        {{#each actionStates}}
                        {{#if dismissible}}
                        <button type="button" class="action-state-badge" role="listitem" data-action="dismissActionState" data-entry-id="{{id}}" data-tooltip-text="{{removeTooltip}}" aria-label="{{ariaLabel}}" draggable="false">
                            {{> actionStateBadgeBody}}
                        </button>
                        {{else}}
                        <span class="action-state-badge" role="listitem" data-tooltip-text="{{tooltip}}" aria-label="{{ariaLabel}}">
                            {{> actionStateBadgeBody}}
                        </span>
                        {{/if}}
                        {{/each}}
                    </span>
                {{/if}}
                {{#ifEquals actorData.type 'npc'}}
                    <span class="npc-badge">{{localize "PMTTRPG.npc"}}</span>
                {{/ifEquals}}
                {{#if showNameRevealEye}}
                    <i class="fas fa-eye char-name-revealed" title="{{localize "PMTTRPG.Combat.TrackerRevealed"}}" aria-hidden="true"></i>
                {{/if}}
                {{#if delayControl}}
                    <span class="delay-intent">
                        <button
                            type="button"
                            class="delay-intent__arm"
                            data-action="armDelay"
                            data-tooltip="{{delayControl.title}}"
                            aria-label="{{delayControl.aria}}"
                        >{{delayControl.label}}</button>
                        {{#if delayControl.armed}}
                            <button
                                type="button"
                                class="delay-intent__cancel"
                                data-action="cancelDelay"
                                data-tooltip-text="{{delayControl.cancelAria}}"
                                aria-label="{{delayControl.cancelAria}}"
                            ><i class="fas fa-xmark" aria-hidden="true"></i></button>
                        {{/if}}
                    </span>
                {{/if}}
            </div>

            <div class="main-stats">
                {{> "systems/projectmoonttrpg/templates/combat/parts/initiative-tracker.hbs"
                    initiative=initiativeValue
                    showValue=showInitiativeValue
                    editable=canEditInitiative
                    showRevealEye=showInitiativeEye
                    showHiddenEye=showInitiativeHiddenEye }}

                {{#each mainStats}}
                    {{> "systems/projectmoonttrpg/templates/combat/parts/main-stat-tracker.hbs" stat=this actorData=../actorData}}
                {{/each}}
            </div>
        </div>
    </div>

    {{#if showDetails}}
    <div class="details" aria-hidden="{{#unless isExpanded}}true{{/unless}}">
        {{#each detailedStats}}
            {{> "systems/projectmoonttrpg/templates/combat/parts/detail-stat-tracker.hbs" stat=this actorData=../actorData}}
        {{/each}}
    </div>
    {{/if}}
</div>
